# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=expensemanager
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_SECRET=YourSuperSecretKeyForJwtTokenGeneration2024MustBeLongEnough!
JWT_ACCESS_TOKEN_EXPIRATION=900000
JWT_REFRESH_TOKEN_EXPIRATION=604800000

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost,https://calceiform-gulfy-orval.ngrok-free.dev

# Mail (configure for email alerts)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-email-password
MAIL_FROM=no-reply@expensemanager.local

# App URLs / Notification config
DASHBOARD_URL=http://localhost:5173/
LARGE_EXPENSE_THRESHOLD=5000
